# Copy this file to `.env` in the repository root (same folder as this file).
# The server reads `.env` from the repo root, not from server/.

# Local MongoDB (default install listens on 27017). For Atlas, paste your
# mongodb+srv://... connection string instead. Must include a database name.
MONGODB_URI=mongodb://127.0.0.1:27017/dsa-tracker

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Frontend origin(s) allowed by CORS; also used to build password-reset links.
# Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173

# API port (optional, default 4000). Vite proxies /api to this port.
PORT=4000

# Optional: password-reset emails. Without these, the reset link is printed
# in the server console in development.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
